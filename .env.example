# ==============================================================================
# Navidrome Lyrics Aggregator - Environment Variables Configuration
# ==============================================================================

# Directory where your audio library is located
MUSIC_DIR=/music
# NLA_MUSIC_DIR=/music

# Path to custom configuration file
# NLA_CONFIG=/config/config.yaml

# Periodic scan interval in daemon mode (e.g. 1h, 30m, 3600s, 1d)
NLA_SCAN_INTERVAL=1h

# Debounce time in seconds for filesystem events
NLA_WATCH_DEBOUNCE_SECONDS=3.0

# Allowed audio vs lyrics duration deviation in seconds
NLA_DURATION_TOLERANCE_SECONDS=2.5

# Minimum similarity score (0.0 - 1.0) to match track
NLA_MIN_SIMILARITY_SCORE=0.75

# Overwrite existing lyrics files (.ttml, .yaml, .lrc)
NLA_OVERWRITE=false

# Automatically upgrade lower quality lyrics (.lrc/.txt) to syllable/word sync (.ttml/.yaml)
NLA_UPGRADE_QUALITY=true

# Search and log without writing any files to disk
NLA_DRY_RUN=false

# Allow unsynced plain text lyrics fallback if no synced lyrics found
NLA_ALLOW_PLAIN_LYRICS=false

# Concurrency & Network
NLA_CONCURRENCY=4
NLA_NETWORK_TIMEOUT=10.0
NLA_MAX_RETRIES=3

# Logging (DEBUG, INFO, WARNING, ERROR)
NLA_LOG_LEVEL=INFO
# NLA_LOG_FILE=/config/aggregator.log

# Active providers list in cascade priority order (comma-separated)
# NLA_ENABLED_PROVIDERS=amll,apple_music,rmmrevival,unison,spicylyrics,binilyrics,lrclib,musixmatch,qqmusic,kuwo,netease,kugou,lyricsify,genius

# Spicy Lyrics Developer API (https://developers.spicylyrics.org)
# SPICY_LYRICS_SECRET_KEY=sl_sk_...
# Optional: Spotify API credentials for automatic track ID resolution
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# FlareSolverr URL for Cloudflare bypass on Lyricsify (optional)
# NLA_FLARESOLVERR_URL=http://localhost:8191/v1
